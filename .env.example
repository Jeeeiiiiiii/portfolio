# GitHub App installed on this repo only — used by the Discord blog bot (docs/blog-bot.md).
# Write: contents, pull-requests.  Read: deployments.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM contents; on Vercel paste as-is (newlines) or with literal 
 — both work
GITHUB_APP_PRIVATE_KEY=
# defaults: Jeeeiiiiiii / portfolio / main
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BASE_BRANCH=

# Contact page map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Discord blog bot (docs/blog-bot.md). Set on Production, with the GitHub App vars above.
# Application → General Information → Public Key
DISCORD_PUBLIC_KEY=
# your own Discord user ID — the only account allowed to run /blog
DISCORD_OWNER_ID=
