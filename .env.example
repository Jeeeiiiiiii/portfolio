# Visitor playground — the write path is off until these exist.
# Production never serves the submit route; set these for Preview (staging) on Vercel.

# GitHub App installed on this repo only.
# Write: contents, pull-requests.  Read (for the live tracker): checks, deployments, commit statuses.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM contents; on Vercel paste as-is (newlines) or with literal \n — both work
GITHUB_APP_PRIVATE_KEY=
# defaults: Jeeeiiiiiii / portfolio / main
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BASE_BRANCH=

# Cloudflare Turnstile (free). The site key is public and gates whether the form renders.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (free tier). Optional: without it the rate limit is skipped (logged).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional salt for hashing IPs before they reach Redis
VISITOR_RATELIMIT_SALT=

# Contact page map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
